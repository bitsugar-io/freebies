{
  "expo": {
    "name": "Freebies",
    "slug": "freebie",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "freebie",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "io.bitsugar.freebies",
      "buildNumber": "2",
      "deploymentTarget": "16.4",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "NSSupportsLiveActivities": true
      },
      "appleTeamId": "MVL7QTYHC4",
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.io.bitsugar.freebies"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "io.bitsugar.freebies",
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#F8B800",
          "sounds": []
        }
      ],
      "expo-secure-store",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000",
          "ios": {
            "image": "./assets/launch.png",
            "resizeMode": "cover",
            "enableFullScreenImage_legacy": true
          }
        }
      ],
      "expo-font",
      "@bacons/apple-targets"
    ],
    "extra": {
      "eas": {
        "projectId": "6c8e96af-5957-4a16-a55f-fe848888487b"
      }
    },
    "owner": "retr0h",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/6c8e96af-5957-4a16-a55f-fe848888487b"
    }
  }
}
